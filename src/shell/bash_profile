#!/bin/bash

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

source_bash_files() {
    declare -r CURRENT_DIRECTORY="$(pwd)"

    declare -r -a FILES_TO_SOURCE=(
        "bash_init"

        "bash_aliases"
        "bash_autocompletion"
        "bash_exports"
        "bash_functions"
        "bash_options"
        "bash_prompt"

        "bash.local"  # For local settings that should
                      # not be under version control.
    )

    local file=""
    local i=""

    # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    source_if_exists() {
        [ -r "$1" ] \
            && . "$1"
    }

    source_context_settings() {

        if [ -z "$DOTFILES_CONTEXT" ]; then
            source_if_exists "$HOME/.bash.context"
        fi

        DOTFILES_SHELL_CONTEXT="$DOTFILES_CONTEXT"

        if [ -z "$DOTFILES_SHELL_CONTEXT" ] && [ "$OS" = "macos" ]; then
            DOTFILES_SHELL_CONTEXT="workstation"
        fi

    }

    set_shell_source_layers() {

        DOTFILES_SHELL_LAYERS=()

        if [ "$OS" = "macos" ]; then
            DOTFILES_SHELL_LAYERS+=("macos")
        elif [ "$(uname -s)" = "Linux" ]; then
            DOTFILES_SHELL_LAYERS+=("linux")

            if [ -d "$DOTFILES_SHELL_DIR/$OS" ]; then
                DOTFILES_SHELL_LAYERS+=("$OS")
            fi
        fi

    }

    source_os_shell_file() {

        local fileName="$1"
        local layer=""

        for layer in "${DOTFILES_SHELL_LAYERS[@]}"; do
            source_if_exists "$DOTFILES_SHELL_DIR/$layer/$fileName"
        done

    }

    source_context_shell_file() {

        local fileName="$1"

        [ -n "$DOTFILES_SHELL_CONTEXT" ] \
            && source_if_exists "$DOTFILES_SHELL_DIR/contexts/$DOTFILES_SHELL_CONTEXT/$fileName"

    }

    # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    cd "$(dirname "$(readlink "${BASH_SOURCE[0]}")")" \
        && . "../os/utils.sh"

    # shellcheck disable=SC2034
    declare -r OS="$(get_os_upstream)"
    declare -r DOTFILES_SHELL_DIR="$(pwd)"

    # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    source_context_settings
    set_shell_source_layers

    # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    for i in ${!FILES_TO_SOURCE[*]}; do

        file="$HOME/.${FILES_TO_SOURCE[$i]}"

        [ -r "$file" ] \
            && . "$file"

    done

    # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    cd "$CURRENT_DIRECTORY"

}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

source_z() {
    # z beats cd most of the time. `brew install z`
    if which brew > /dev/null; then
        zpath="$(brew --prefix)/etc/profile.d/z.sh"
        [ -s "$zpath" ] && source "$zpath"
    elif test -f ~/z.sh; then
        . ~/z.sh
    fi;
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

source_bash_files
source_z
unset -f source_bash_files

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Clear system messages (system copyright notice, the date
# and time of the last login, the message of the day, etc.).

#clear
